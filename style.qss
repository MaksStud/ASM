QWidget {
    background-color: #202124;
    color: white;
    font-family: Segoe UI;
    font-size: 14px;
}

QLineEdit, QTextEdit {
    background-color: #2d2f31;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 6px;
}

QPushButton {
    background-color: #4a90e2;
    border: none;
    border-radius: 6px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #357ae8;
}

#LogButton {
    background-color: transparent;
    border: 1px solid #555;
    color: #aaa;
    border-radius: 3px;
    font-weight: normal;
    font-size: 12px;
}

#LogButton:hover {
    background-color: #333;
    color: white;
    border: 1px solid #777;
}